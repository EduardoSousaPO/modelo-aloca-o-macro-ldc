# ============================================================
# .env.example — [Nome do Agente]
# Gerado pelo Agent Builder Copilot (ABC)
# ============================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Preencha os valores reais (nunca commite o .env no git)
# 3. No VPS: copie para ~/.openclaw/.env
# 4. Proteja: chmod 600 ~/.openclaw/.env
# ============================================================

# ============================================================
# LLM PROVIDER (escolha um, comente os outros)
# ============================================================

# Anthropic (Claude) — padrão recomendado
ANTHROPIC_API_KEY=sk-ant-COLOQUE_SUA_KEY_AQUI

# OpenAI (GPT)
# OPENAI_API_KEY=sk-COLOQUE_SUA_KEY_AQUI

# Google (Gemini)
# GOOGLE_AI_API_KEY=COLOQUE_SUA_KEY_AQUI

# ============================================================
# CANAL DE COMUNICAÇÃO (configure o que for usar)
# ============================================================

# Telegram
# TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# WhatsApp (requer conta Business aprovada pela Meta)
# WHATSAPP_TOKEN=COLOQUE_SEU_TOKEN_AQUI

# ============================================================
# SUPABASE
# ============================================================

# URL do projeto (encontrar em Settings → API no painel Supabase)
# SUPABASE_URL=https://XXXXX.supabase.co

# Service Role Key (NUNCA expor no frontend — apenas backend/agente)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anon Key (seguro para frontend — protegido por RLS)
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# GATEWAY OPENCLAW
# ============================================================

# Token de autenticação do gateway (gere um valor aleatório forte)
# GATEWAY_AUTH_TOKEN=GERE_UM_TOKEN_ALEATORIO_AQUI

# ============================================================
# INTEGRAÇÕES ADICIONAIS (adicionar conforme necessidade)
# ============================================================

# Exemplo: CRM
# CRM_API_KEY=COLOQUE_SUA_KEY_AQUI
# CRM_BASE_URL=https://api.seucrm.com

# Exemplo: Email (SendGrid, Resend, etc.)
# EMAIL_API_KEY=COLOQUE_SUA_KEY_AQUI
# EMAIL_FROM=agente@seudominio.com

# ============================================================
# OBSERVAÇÕES
# ============================================================
# - NUNCA commite este arquivo preenchido no GitHub
# - Verifique que .env está no .gitignore
# - No VPS, proteja com: chmod 600 ~/.openclaw/.env
# - Rotacione keys periodicamente
# - Use keys com menor privilégio possível
